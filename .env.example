# AI Alert Agent - Environment Variables
# Copy this to .env and fill in your values, then run:
#   set -a && source .env && set +a

# Slack Integration (Required)
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN-HERE
SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN-HERE

# Sentry Integration (Required)
SENTRY_API_TOKEN=sntrys_YOUR-TOKEN-HERE

# Claude/Anthropic Integration (Required)
ANTHROPIC_API_KEY=sk-ant-YOUR-API-KEY-HERE

# AWS/CloudWatch (Optional)
AWS_PROFILE=default
AWS_REGION=us-west-2

# Logging (Optional)
LOG_LEVEL=info
